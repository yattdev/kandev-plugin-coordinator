{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "types": ["vitest/globals"],
    "jsx": "react-jsx"
  },
  "include": ["ui/src/**/*.ts", "ui/src/**/*.tsx"]
}
